<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>

		<!-- 根命名空间（建议与程序集名一致） -->
		<RootNamespace>AnimalIsland</RootNamespace>
		<AssemblyName>AnimalIsland</AssemblyName>

		<!-- ========== NuGet 包元数据 ========== -->
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>AnimalIsland</PackageId>
		<Version>1.0.0</Version>
		<Authors>YourName</Authors>
		<Description>Animal Crossing style theme library for HandyControl</Description>
		<PackageTags>WPF;HandyControl;Theme;AnimalCrossing</PackageTags>

	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="HandyControl" Version="3.5.1" PrivateAssets="all" />
	</ItemGroup>
	<ItemGroup>
		<Resource Include="Themes/Assets/**/*" />
	</ItemGroup>

</Project>
