<Window x:Class="LoginWindow.Views.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LoginWindow.Views"
        mc:Ignorable="d"
        Background="#1E1E1D"
        Style="{DynamicResource WindowBaseStyle}"
        Title="设置" Height="900" Width="980"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="PathTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" CornerRadius="8" Background="#333333" BorderBrush="#555555" BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="BorderBrush" TargetName="border" Value="#f1b054"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter Property="BorderBrush" TargetName="border" Value="#f1b054"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Background" Value="#f1b054"/>
            <Setter Property="Foreground" Value="#1E1E1D"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BrowseButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="MinWidth" Value="84"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
        </Style>

        <Style x:Key="ScanButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}"/>

        <Style x:Key="FooterButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Background" Value="#1E1E1D"/>
            <Setter Property="Foreground" Value="#f1b054"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="#C0392B"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="12,0,12,8"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#2B2B2B"/>
            <Setter Property="Foreground" Value="#DCDCDC"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="DangerPageButtonStyle" TargetType="Button" BasedOn="{StaticResource DangerButtonStyle}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="0,0,10,10" Background="#f1b054" Padding="15,8">
            <TextBlock Text="设置" FontSize="20" FontWeight="Bold" Foreground="#1E1E1D"/>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#181818" Padding="0,20,0,0">
                <StackPanel>
                    <Button Content="媒体配置"
                            Command="{Binding SetConfigPageCommand}"
                            CommandParameter="Library">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveConfigPage}" Value="Library">
                                        <Setter Property="Background" Value="#f1b054"/>
                                        <Setter Property="Foreground" Value="#1E1E1D"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="危险操作"
                            Command="{Binding SetConfigPageCommand}"
                            CommandParameter="Danger">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveConfigPage}" Value="Danger">
                                        <Setter Property="Background" Value="#C0392B"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveConfigPage}" Value="Library">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <Grid Margin="30,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="图片根目录" Foreground="#f1b054" FontSize="14" Margin="0,0,0,8"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding PictureRootPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PathTextBoxStyle}"/>
                            <Button Grid.Column="1" Content="浏览..." Command="{Binding BrowseCommand}" CommandParameter="picture" Style="{StaticResource BrowseButtonStyle}"/>
                        </Grid>

                        <TextBlock Grid.Row="2" Text="电影海报根目录" Foreground="#f1b054" FontSize="14" Margin="0,14,0,8"/>
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding MoviePosterRootPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PathTextBoxStyle}"/>
                            <Button Grid.Column="1" Content="浏览..." Command="{Binding BrowseCommand}" CommandParameter="poster" Style="{StaticResource BrowseButtonStyle}"/>
                        </Grid>

                        <TextBlock Grid.Row="4" Text="媒体根目录" Foreground="#f1b054" FontSize="14" Margin="0,14,0,8"/>
                        <Grid Grid.Row="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding MediaRootPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PathTextBoxStyle}"/>
                            <Button Grid.Column="1" Content="浏览..." Command="{Binding BrowseCommand}" CommandParameter="media" Style="{StaticResource BrowseButtonStyle}"/>
                        </Grid>

                        <TextBlock Grid.Row="6" Text="游戏根目录" Foreground="#f1b054" FontSize="14" Margin="0,14,0,8"/>
                        <Grid Grid.Row="7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding GameRootPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PathTextBoxStyle}"/>
                            <Button Grid.Column="1" Content="浏览..." Command="{Binding BrowseCommand}" CommandParameter="game" Style="{StaticResource BrowseButtonStyle}"/>
                        </Grid>

                        <TextBlock Grid.Row="8" Text="游戏海报根目录" Foreground="#f1b054" FontSize="14" Margin="0,14,0,8"/>
                        <Grid Grid.Row="9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding GamePosterRootPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PathTextBoxStyle}"/>
                            <Button Grid.Column="1" Content="浏览..." Command="{Binding BrowseCommand}" CommandParameter="gamePoster" Style="{StaticResource BrowseButtonStyle}"/>
                        </Grid>

                        <TextBlock Grid.Row="10" Text="漫画根目录" Foreground="#f1b054" FontSize="14" Margin="0,14,0,8"/>
                        <Grid Grid.Row="11">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding MangaRootPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PathTextBoxStyle}"/>
                            <Button Grid.Column="1" Content="浏览..." Command="{Binding BrowseCommand}" CommandParameter="manga" Style="{StaticResource BrowseButtonStyle}"/>
                        </Grid>

                        <TextBlock Grid.Row="12" Text="漫画封面根目录" Foreground="#f1b054" FontSize="14" Margin="0,14,0,8"/>
                        <Grid Grid.Row="13">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding MangaPosterRootPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PathTextBoxStyle}"/>
                            <Button Grid.Column="1" Content="浏览..." Command="{Binding BrowseCommand}" CommandParameter="mangaPoster" Style="{StaticResource BrowseButtonStyle}"/>
                        </Grid>

                        <StackPanel Grid.Row="14" Margin="0,16,0,0">
                            <UniformGrid Columns="2" Rows="2" Margin="0,0,0,14">
                                <Button Content="完整扫描电影" Command="{Binding FullMovieScanCommand}"
                                        ToolTip="重新处理所有已有视频，并重试缺失海报"
                                        Margin="0,0,8,8"
                                        Style="{StaticResource ScanButtonStyle}"/>
                                <Button Content="完整扫描图片" Command="{Binding FullPictureScanCommand}"
                                        ToolTip="重新处理所有已有图片，并同步文件信息和标签"
                                        Margin="8,0,0,8"
                                        Style="{StaticResource ScanButtonStyle}"/>
                                <Button Content="完整扫描漫画" Command="{Binding FullMangaScanCommand}"
                                        ToolTip="重新处理所有已有 PDF，并重试缺失封面"
                                        Margin="0,8,8,0"
                                        Style="{StaticResource ScanButtonStyle}"/>
                                <Button Content="完整扫描游戏" Command="{Binding FullGameScanCommand}"
                                        ToolTip="重新处理所有已有游戏文件夹，并同步海报和标签"
                                        Margin="8,8,0,0"
                                        Style="{StaticResource ScanButtonStyle}"/>
                            </UniformGrid>
                            <ProgressBar Height="6" IsIndeterminate="True" Margin="0,0,0,8">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveConfigPage}" Value="Danger">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel Margin="30,24">
                        <TextBlock Text="数据操作" Foreground="#f1b054" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="当前账户不是 admin，无法执行清空操作。"
                                   Foreground="#C0392B" FontSize="13" Margin="0,0,0,16">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <UniformGrid Columns="2" Rows="2" Margin="0,0,0,6">
                            <Button Content="清空电影库" Command="{Binding ClearMovieLibraryCommand}"
                                    ToolTip="删除电影及电影标签记录"
                                    Style="{StaticResource DangerPageButtonStyle}"/>
                            <Button Content="清空图片库" Command="{Binding ClearPictureLibraryCommand}"
                                    ToolTip="删除图片及图片标签记录"
                                    Style="{StaticResource DangerPageButtonStyle}"/>
                            <Button Content="清空漫画库" Command="{Binding ClearMangaLibraryCommand}"
                                    ToolTip="删除漫画及漫画标签记录"
                                    Style="{StaticResource DangerPageButtonStyle}"/>
                            <Button Content="清空游戏库" Command="{Binding ClearGameLibraryCommand}"
                                    ToolTip="删除游戏及游戏标签记录"
                                    Style="{StaticResource DangerPageButtonStyle}"/>
                        </UniformGrid>

                        <Button Content="清空全部媒体库"
                                Command="{Binding ClearLibraryCommand}"
                                ToolTip="删除电影、图片、漫画、游戏及其标签记录"
                                Width="724"
                                HorizontalAlignment="Left"
                                Style="{StaticResource DangerPageButtonStyle}"/>

                        <ProgressBar Height="6" IsIndeterminate="True" Margin="0,8,0,8">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#f1b054" CornerRadius="10,10,0,0" Padding="15,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActiveConfigPage}" Value="Library">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="完整扫描全部" Command="{Binding FullAllScanCommand}"
                        ToolTip="重新处理所有电影、图片、漫画和游戏"
                        Style="{StaticResource FooterButtonStyle}"/>
                <Button Content="保存（增量扫描）" Command="{Binding SaveCommand}"
                        ToolTip="已有记录直接跳过，只处理新导入的文件"
                        Style="{StaticResource FooterButtonStyle}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
