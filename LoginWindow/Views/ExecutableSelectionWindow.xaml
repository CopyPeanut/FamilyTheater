<Window x:Class="LoginWindow.Views.ExecutableSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择启动程序"
        Width="760" Height="460"
        Background="#1E1E1D"
        WindowStartupLocation="CenterOwner"
        Style="{DynamicResource WindowBaseStyle}"
        ResizeMode="NoResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="检测到多个 exe，请选择要作为启动项的程序"
                   Foreground="#f1b054" FontSize="16" FontWeight="Bold"
                   Margin="0,0,0,12"/>

        <Border Grid.Row="1" BorderBrush="#f1b054" BorderThickness="1"
                CornerRadius="8" Background="#222220">
            <ListBox x:Name="ExecutableList"
                     ItemsSource="{Binding Executables}"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="#E0E0E0"
                     MouseDoubleClick="ExecutableList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="8,6">
                            <TextBlock Text="{Binding FileName}" FontSize="14" Foreground="White"/>
                            <TextBlock Text="{Binding RelativePath}" FontSize="12" Foreground="#AAAAAA"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" Click="Cancel_Click"
                    Width="84" Height="32" Margin="0,0,8,0"
                    Background="#333333" Foreground="#DDDDDD"
                    BorderThickness="0" Cursor="Hand"/>
            <Button Content="确定" Click="Confirm_Click"
                    Width="84" Height="32"
                    Background="#f1b054" Foreground="#1E1E1D" FontWeight="Bold"
                    BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
