<Window x:Class="LoginWindow.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LoginWindow.Views"
        xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Background="#1E1E1D"
        Style="{DynamicResource WindowBaseStyle}"
        Title="修改密码" Height="520" Width="430">
    <Grid>
        <local:StarfieldBackground StarCount="70" />

        <StackPanel VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Width="320">

            <TextBlock Text="修改密码"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,58,0,54"/>

            <hc:PasswordBox hc:InfoElement.Placeholder="旧密码"
                            IsSafeEnabled="False"
                            hc:InfoElement.Necessary="True"
                            UnsafePassword="{Binding OldPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,0,0,26"/>

            <hc:PasswordBox hc:InfoElement.Placeholder="新密码"
                            IsSafeEnabled="False"
                            hc:InfoElement.Necessary="True"
                            UnsafePassword="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,0,0,26"/>

            <hc:PasswordBox hc:InfoElement.Placeholder="确认新密码"
                            IsSafeEnabled="False"
                            hc:InfoElement.Necessary="True"
                            UnsafePassword="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,0,0,34"/>

            <Button Content="保 存"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsSaving, Converter={StaticResource Boolean2BooleanReConverter}}"
                    HorizontalAlignment="Stretch"
                    Height="44"
                    FontSize="16"/>
        </StackPanel>
    </Grid>
</Window>
