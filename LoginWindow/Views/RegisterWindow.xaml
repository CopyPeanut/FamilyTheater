<Window x:Class="LoginWindow.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LoginWindow.Views"
        xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Background="#1E1E1D"
        Style="{DynamicResource WindowBaseStyle}"
        Title="RegisterWindow" Height="800" Width="450">
    <Grid>
        <local:StarfieldBackground StarCount="70" />

        <StackPanel VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Width="320">

            <TextBlock Text="创建新账号"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,70,0,70" />

            <hc:TextBox hc:InfoElement.Placeholder="用户名"
                        hc:InfoElement.Necessary="True"
                        Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,0,30" />

            <hc:PasswordBox hc:InfoElement.Placeholder="密码" IsSafeEnabled="False"
                            hc:InfoElement.Necessary="True"
                            UnsafePassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,0,0,30" />

            <!-- 确认密码 -->
            <hc:PasswordBox hc:InfoElement.Placeholder="确认密码" IsSafeEnabled="False"
                            hc:InfoElement.Necessary="True"
                            UnsafePassword="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,0,0,30" />

            <!-- 注册按钮 -->
            <Button Content="注 册"
                       Command="{Binding RegisterCommand}"
                       IsEnabled="{Binding IsRegistering, Converter={StaticResource Boolean2BooleanReConverter}}"
                       HorizontalAlignment="Stretch"
                       Height="44"
                       FontSize="16" />
        </StackPanel>
    </Grid>
</Window>
