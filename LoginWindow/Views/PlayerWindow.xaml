<Window x:Class="LoginWindow.Views.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="播放" Background="Black" WindowState="Maximized"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 视频区域 -->
        <MediaElement x:Name="Player" Grid.Row="0" Stretch="Uniform"
                      LoadedBehavior="Manual" UnloadedBehavior="Stop"
                      MediaOpened="Player_MediaOpened"
                      MediaEnded="Player_MediaEnded"
                      MediaFailed="Player_MediaFailed"/>

        <!-- 控制栏 -->
        <Grid Grid.Row="1" Background="#1E1E1D">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 播放/暂停按钮 -->
            <Button x:Name="PlayPauseBtn" Grid.Column="0" Click="PlayPauseBtn_Click"
                    Width="40" Height="32" Margin="8,4" Background="Transparent"
                    BorderThickness="0" Foreground="White" FontSize="16" Cursor="Hand">
                <TextBlock x:Name="PlayPauseIcon" Text="⏸" FontSize="18"/>
            </Button>

            <!-- 进度条 -->
            <Slider x:Name="ProgressSlider" Grid.Column="1" VerticalAlignment="Center"
                    Margin="10,0" Minimum="0" Maximum="1"
                    Thumb.DragStarted="ProgressSlider_DragStarted"
                    Thumb.DragCompleted="ProgressSlider_DragCompleted"
                    ValueChanged="ProgressSlider_ValueChanged"/>

            <!-- 时间显示 -->
            <TextBlock x:Name="TimeDisplay" Grid.Column="2" VerticalAlignment="Center"
                       Foreground="#CCCCCC" FontSize="13" Margin="10,0"
                       Text="00:00 / 00:00"/>

            <!-- 关闭按钮 -->
            <Button Grid.Column="3" Click="CloseBtn_Click"
                    Width="40" Height="32" Margin="8,4" Background="Transparent"
                    BorderThickness="0" Foreground="#f1b054" FontSize="16"
                    Cursor="Hand" Content="✕"/>
        </Grid>
    </Grid>
</Window>
