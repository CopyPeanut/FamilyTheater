<Window x:Class="LoginWindow.Views.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LoginWindow.Views"
        xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
        mc:Ignorable="d"
        Title="Login" Height="450" Width="800"
        ResizeMode="NoResize"
        Background="#1E1E1D"
        Style="{DynamicResource WindowBaseStyle}">
    <Grid>
        <local:StarfieldBackground StarCount="70" />

        <!--这里是登录的主要部分-->
        <Grid Margin="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.4*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!--第一大列，标题-->
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Grid.Row="0" Grid.RowSpan="4" Grid.Column="0">
                <TextBlock Text="" FontSize="40" Foreground="White" HorizontalAlignment="Center" Margin="20" />
                <TextBlock Text="" FontSize="40" Foreground="White" HorizontalAlignment="Center" Margin="20" />
                <TextBlock Text="" FontSize="40" Foreground="White" HorizontalAlignment="Center" Margin="20" />
                <TextBlock Text="" FontSize="40" Foreground="White" HorizontalAlignment="Center" Margin="20" />
            </StackPanel>

            <!--第二列-->
            <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="/Resource/user.ico"  Width="20" Height="20" Margin="0,0,0,0" VerticalAlignment="Center" Panel.ZIndex="1"/>
                <hc:TextBox x:Name="UserName" hc:InfoElement.Placeholder="用户名" hc:InfoElement.Necessary="True"
                            Margin="8,5,5,5" VerticalAlignment="Center" HorizontalAlignment="Center" Width="300" Height="40"
                            Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"  
                 />
            </StackPanel>

            <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="/Resource/key.ico"  Width="20" Height="20" Margin="0,0,5,0" VerticalAlignment="Center" Panel.ZIndex="1"/>
                <hc:PasswordBox x:Name="Password" hc:InfoElement.Placeholder="密码" hc:InfoElement.Necessary="True"  
                                Margin="5" VerticalAlignment="Center" HorizontalAlignment="Center"  Width="300" Height="40"
                                UnsafePassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsSafeEnabled="False"/>
            </StackPanel>
            <Button Content="登入" Style="{StaticResource ButtonWarning}" Margin="240,0,0,0" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Center"
                    Width="80" Height="40" FontSize="20" Command="{Binding LoginCmd}"/>
            <TextBlock  VerticalAlignment="Top" HorizontalAlignment="Center" Margin="214,0,0,0" Grid.Column="1" Grid.Row="3">
                    <Hyperlink TextDecorations="None" Foreground="#DCDCDC" Command="{Binding RegisterCmd}">
                        没有账号？立即注册
                    </Hyperlink>
            </TextBlock>
            <!--<StackPanel Grid.Column="1" Grid.Row="2" Grid.RowSpan="2" 
            Orientation="Horizontal" 
            HorizontalAlignment="Center" 
            VerticalAlignment="Center">
                <Button Width="200" Height="50" Content="登入" Style="{StaticResource ButtonWarning}" Margin="0,0,16,0" />
                <Button Width="200" Height="50" Content="注册" Style="{StaticResource ButtonWarning}" />
            </StackPanel>-->

        </Grid>
    </Grid>
</Window>
