<Window x:Class="LoginWindow.Views.PdfViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LoginWindow.Views"
        Title="PDF" Background="#1E1E1D" Width="1800" Height="1000"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        Loaded="PdfViewerWindow_Loaded"
        SizeChanged="PdfViewerWindow_SizeChanged">
    <Grid PreviewMouseWheel="Root_PreviewMouseWheel">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#111111">
            <ScrollViewer x:Name="PageScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          PreviewMouseLeftButtonDown="PageScrollViewer_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="PageScrollViewer_PreviewMouseMove"
                          PreviewMouseLeftButtonUp="PageScrollViewer_PreviewMouseLeftButtonUp"
                          LostMouseCapture="PageScrollViewer_LostMouseCapture">
                <Grid MinWidth="{Binding ActualWidth, ElementName=PageScrollViewer}"
                      MinHeight="{Binding ActualHeight, ElementName=PageScrollViewer}">
                    <Image x:Name="PageImage"
                           Stretch="Fill"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                    <TextBlock x:Name="LoadingText"
                               Text="Loading..."
                               Foreground="#CCCCCC"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
            </ScrollViewer>

            <Button x:Name="ShowControlsButton"
                    Content="⌃"
                    Width="42" Height="30"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,16,16"
                    Background="#f1b054"
                    Foreground="#1E1E1D"
                    BorderThickness="0"
                    FontSize="16"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Visibility="Collapsed"
                    Click="ShowControlsButton_Click"/>
        </Grid>

        <Grid x:Name="ControlBar" Grid.Row="1" Background="#1E1E1D" MinHeight="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="上一页"
                    Click="PrevPage_Click"
                    Width="72" Height="32" Margin="8,8,4,8"
                    Background="#333333" Foreground="White"
                    BorderBrush="#555555" Cursor="Hand"/>

            <Button Grid.Column="1" Content="下一页"
                    Click="NextPage_Click"
                    Width="72" Height="32" Margin="4,8"
                    Background="#333333" Foreground="White"
                    BorderBrush="#555555" Cursor="Hand"/>

            <local:JumpSlider x:Name="PageSlider"
                              Grid.Column="2"
                              Minimum="1"
                              Maximum="1"
                              Value="1"
                              Margin="12,0"
                              VerticalAlignment="Center"
                              ValueChanged="PageSlider_ValueChanged"/>

            <TextBlock x:Name="PageDisplay"
                       Grid.Column="3"
                       Text="0 / 0"
                       Foreground="#CCCCCC"
                       FontSize="13"
                       Margin="10,0"
                       VerticalAlignment="Center"/>

            <CheckBox x:Name="AutoPageCheckBox"
                      Grid.Column="4"
                      Content="自动翻页"
                      Foreground="#CCCCCC"
                      Margin="12,0,6,0"
                      VerticalAlignment="Center"
                      Checked="AutoPageCheckBox_Changed"
                      Unchecked="AutoPageCheckBox_Changed"/>

            <TextBox x:Name="AutoPageSecondsInput"
                     Grid.Column="5"
                     Text="5"
                     Width="48" Height="30"
                     Background="#333333"
                     Foreground="White"
                     BorderBrush="#555555"
                     VerticalContentAlignment="Center"
                     HorizontalContentAlignment="Center"
                     Margin="4,0"
                     LostFocus="AutoPageSecondsInput_LostFocus"
                     KeyDown="AutoPageSecondsInput_KeyDown"/>

            <TextBlock Grid.Column="6"
                       Text="秒"
                       Foreground="#CCCCCC"
                       Margin="2,0,12,0"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="ZoomDisplay"
                           Text="100%"
                           Foreground="#CCCCCC"
                           FontSize="13"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"/>
                <Button Content="隐藏"
                        Click="HideControlsButton_Click"
                        Width="58" Height="32"
                        Margin="0,8,4,8"
                        Background="#333333"
                        Foreground="White"
                        BorderBrush="#555555"
                        Cursor="Hand"/>
                <Button Click="CloseBtn_Click"
                        Width="40" Height="32"
                        Margin="4,8,8,8"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#f1b054"
                        FontSize="16"
                        Cursor="Hand"
                        Content="×"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
