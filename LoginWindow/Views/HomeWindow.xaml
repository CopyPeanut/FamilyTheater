<Window x:Class="LoginWindow.Views.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LoginWindow.Views"
        mc:Ignorable="d"
        Background="#1E1E1D"
        Style="{DynamicResource WindowBaseStyle}"
        Title="" Height="1000" Width="1800">
    <Grid>
        <local:StarfieldBackground StarCount="70" />

        <Grid>
            <Grid.ColumnDefinitions>

            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="0.05*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

                <Grid x:Name="Title" Grid.Row="0" Background="#f1b054">
                    <!-- 定义两列，让按钮靠右对齐 -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 按钮容器，靠右对齐，并设置统一的图标大小和间距 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0" >

                    <!-- 1. 设置按钮 -->
                    <Button Command="{Binding}" Background="Transparent" BorderThickness="0" ToolTip="设置" Margin="0,5,5,0" Height="50">
                        <Image Source="/Resource/cog-fill-w.png" Width="30" Height="30"  RenderTransformOrigin="0.523,0.327"/>
                    </Button>

                    <!-- 2. 账户下拉选单 -->
                    <Menu Background="Transparent" VerticalAlignment="Center">
                        <MenuItem Padding="8" ToolTip="账户">
                            <MenuItem.Header>
                                <Image Source="/Resource/user-group-w.png" Width="40" Height="40" />
                            </MenuItem.Header>

                            <!-- 下拉菜单项 -->
                            <MenuItem Header="个人资料" Command="{Binding}"/>
                            <MenuItem Header="修改密码" Command="{Binding}"/>
                            <Separator />
                            <MenuItem Header="退出登录" Command="{Binding}"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>
            </Grid>
        </Grid>
       
       
    </Grid>
     
</Window>
