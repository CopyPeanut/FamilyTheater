<Window x:Class="LoginWindow.Views.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LoginWindow.Views"
        mc:Ignorable="d"
        Background="#1E1E1D"
        Style="{DynamicResource WindowBaseStyle}"
        Title="" Height="1000" Width="1800">
    <Window.Resources>
        <local:PageMatchConverter x:Key="PageMatchConverter"/>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <local:StarfieldBackground StarCount="70" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="0.05*"/>
                <RowDefinition Height="0.3*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="0.1*"/>
            </Grid.RowDefinitions>

            <Border CornerRadius="0,0,10,10" Background="#f1b054" Padding="10">
                <Grid x:Name="Title" Grid.Row="0" Margin="0,-10,0,-10">
                    <!-- 定义两列，让按钮靠右对齐 -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 按钮容器，靠右对齐，并设置统一的图标大小和间距 -->
                    <StackPanel  Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">

                        <!-- 1. 设置按钮 -->
                        <Button Command="{Binding OpenConfigCmd}" Background="Transparent" BorderThickness="0" ToolTip="设置" Margin="0,5,5,0" Height="37">
                            <Image Source="/Resource/cog-fill-w.png" Width="30" Height="25" />
                        </Button>

                        <!-- 2. 账户下拉选单 -->
                        <Menu Background="Transparent" >
                            <MenuItem Padding="8" ToolTip="账户" Height="45" RenderTransformOrigin="0.517,0.112">
                                <MenuItem.Header>
                                    <Image Source="/Resource/user-group-w.png" Width="40" Height="28"  />
                                </MenuItem.Header>

                                <!-- 下拉菜单项 -->
                                <MenuItem Header="个人资料" Command="{Binding}"/>
                                <MenuItem Header="修改密码" Command="{Binding}"/>
                                <Separator />
                                <MenuItem Header="退出登录" Command="{Binding}"/>
                            </MenuItem>
                        </Menu>
                    </StackPanel>
                </Grid>
            </Border>


            <!-- 筛选区域 -->
            <Border Grid.Row="1" Margin="20"  BorderBrush="#f1b054"  BorderThickness="1"  CornerRadius="10"  Background="Transparent">

                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <!-- 搜索栏 -->
                        <RowDefinition Height="Auto"/>
                        <!-- 其他筛选内容 -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 1. 搜索栏 -->
                    <TextBox Grid.Row="0" Height="35" Margin="0,0,0,15" Background="#333333" Foreground="White" BorderBrush="#555555" 
                             BorderThickness="1" Padding="10,0" VerticalContentAlignment="Center" Text="{Binding SearchText}">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="#f1b054"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <!-- 这里的 Border 负责显示圆角和背景色 -->
                                <Border x:Name="border"  CornerRadius="8" Background="#333333" BorderBrush="#555555" BorderThickness="1" 
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer x:Name="PART_ContentHost"  Focusable="false"  HorizontalScrollBarVisibility="Hidden"  VerticalScrollBarVisibility="Hidden"/>
                                </Border>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="true">
                                        <Setter Property="BorderBrush" TargetName="border" Value="#f1b054"/>
                                    </Trigger>
                                    <Trigger Property="IsFocused" Value="true">
                                        <Setter Property="BorderBrush" TargetName="border" Value="#f1b054"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>

                    <!-- 2. 其他筛选控件区域 (示例) -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <!-- 你可以在这里添加 CheckBox, ComboBox 等其他筛选控件 -->
                        <TextBlock Text="这里是其他筛选控件的位置" Foreground="Gray" VerticalAlignment="Center"/>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- 分页控件区域 -->
            <Border Grid.Row="3" Background="#f1b054" CornerRadius="10,10,0,0" Padding="15,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                    <!-- 页码小方块（当前页±5） -->
                    <ItemsControl ItemsSource="{Binding PageNumbers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="32" Height="32" Margin="4,0">
                                    <Button Content="{Binding}" Visibility="{Binding Converter={StaticResource NullToVisibilityConverter}}"
                                            Command="{Binding DataContext.GoToPageCmd, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" FontSize="14" Cursor="Hand" BorderThickness="0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Black"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource PageMatchConverter}">
                                                                <Binding/>
                                                                <Binding RelativeSource="{RelativeSource AncestorType=Window}"
                                                                         Path="DataContext.CurrentPage"/>
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="Foreground" Value="Black"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 跳转输入框（跟在方块后面） -->
                    <TextBlock Text="跳转" Foreground="Black" VerticalAlignment="Center" Margin="20,0,5,0" FontSize="14"/>
                    <TextBox Text="{Binding JumpPageText, UpdateSourceTrigger=PropertyChanged}"
                             Width="50" Height="32" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                             FontSize="14" Background="Black" Foreground="White" BorderBrush="#555555" BorderThickness="1" Padding="0">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding JumpPageCmd}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                </StackPanel>
            </Border>
        </Grid>


    </Grid>

</Window>
