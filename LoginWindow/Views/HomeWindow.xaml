<Window x:Class="LoginWindow.Views.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LoginWindow.Views"
        mc:Ignorable="d"
        Background="#1E1E1D"
        Style="{DynamicResource WindowBaseStyle}"
        Title="" Height="1000" Width="1800">
    <Window.Resources>
        <local:PageMatchConverter x:Key="PageMatchConverter"/>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <local:StarfieldBackground StarCount="70" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="0.05*"/>
                <RowDefinition Height="0.3*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="0.1*"/>
            </Grid.RowDefinitions>

            <Border CornerRadius="0,0,10,10" Background="#f1b054" Padding="10">
                <Grid x:Name="Title" Grid.Row="0" Margin="0,-10,0,-10">
                    <!-- 定义两列，让按钮靠右对齐 -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 分类切换选项 -->
                      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                          <Button Content="Movie" Command="{Binding SwitchCategoryCmd}" CommandParameter="movie">
                              <Button.Style>
                                  <Style TargetType="Button">
                                      <Setter Property="Cursor" Value="Hand"/>
                                      <Setter Property="BorderThickness" Value="0"/>
                                      <Setter Property="FontSize" Value="16"/>
                                      <Setter Property="FontWeight" Value="Normal"/>
                                      <Setter Property="Foreground" Value="White"/>
                                      <Setter Property="Background" Value="Transparent"/>
                                      <Setter Property="Padding" Value="0"/>
                                      <Setter Property="Template">
                                          <Setter.Value>
                                              <ControlTemplate TargetType="Button">
                                                  <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                  </Border>
                                              </ControlTemplate>
                                          </Setter.Value>
                                      </Setter>
                                      <Style.Triggers>
                                          <DataTrigger Binding="{Binding ActiveCategory}" Value="movie">
                                              <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="Black"/>
                                            <Setter Property="Padding" Value="8,2"/>
                                          </DataTrigger>
                                      </Style.Triggers>
                                  </Style>
                              </Button.Style>
                          </Button>

                          <TextBlock Text="|" Foreground="White" FontSize="16" Margin="12,0,12,0" VerticalAlignment="Center"/>

                          <Button Content="Picture" Command="{Binding SwitchCategoryCmd}" CommandParameter="picture">
                              <Button.Style>
                                  <Style TargetType="Button">
                                      <Setter Property="Cursor" Value="Hand"/>
                                      <Setter Property="BorderThickness" Value="0"/>
                                      <Setter Property="FontSize" Value="16"/>
                                      <Setter Property="FontWeight" Value="Normal"/>
                                      <Setter Property="Foreground" Value="White"/>
                                      <Setter Property="Background" Value="Transparent"/>
                                      <Setter Property="Padding" Value="0"/>
                                      <Setter Property="Template">
                                          <Setter.Value>
                                              <ControlTemplate TargetType="Button">
                                                  <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                  </Border>
                                              </ControlTemplate>
                                          </Setter.Value>
                                      </Setter>
                                      <Style.Triggers>
                                          <DataTrigger Binding="{Binding ActiveCategory}" Value="picture">
                                              <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="Black"/>
                                            <Setter Property="Padding" Value="8,2"/>
                                          </DataTrigger>
                                      </Style.Triggers>
                                  </Style>
                              </Button.Style>
                          </Button>

                          <TextBlock Text="|" Foreground="White" FontSize="16" Margin="12,0,12,0" VerticalAlignment="Center"/>

                          <Button Content="Manga" Command="{Binding SwitchCategoryCmd}" CommandParameter="manga">
                              <Button.Style>
                                  <Style TargetType="Button">
                                      <Setter Property="Cursor" Value="Hand"/>
                                      <Setter Property="BorderThickness" Value="0"/>
                                      <Setter Property="FontSize" Value="16"/>
                                      <Setter Property="FontWeight" Value="Normal"/>
                                      <Setter Property="Foreground" Value="White"/>
                                      <Setter Property="Background" Value="Transparent"/>
                                      <Setter Property="Padding" Value="0"/>
                                      <Setter Property="Template">
                                          <Setter.Value>
                                              <ControlTemplate TargetType="Button">
                                                  <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                  </Border>
                                              </ControlTemplate>
                                          </Setter.Value>
                                      </Setter>
                                      <Style.Triggers>
                                          <DataTrigger Binding="{Binding ActiveCategory}" Value="manga">
                                              <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="Black"/>
                                            <Setter Property="Padding" Value="8,2"/>
                                          </DataTrigger>
                                      </Style.Triggers>
                                  </Style>
                              </Button.Style>
                          </Button>

                          <TextBlock Text="|" Foreground="White" FontSize="16" Margin="12,0,12,0" VerticalAlignment="Center"/>

                          <Button Content="Game" Command="{Binding SwitchCategoryCmd}" CommandParameter="game">
                              <Button.Style>
                                  <Style TargetType="Button">
                                      <Setter Property="Cursor" Value="Hand"/>
                                      <Setter Property="BorderThickness" Value="0"/>
                                      <Setter Property="FontSize" Value="16"/>
                                      <Setter Property="FontWeight" Value="Normal"/>
                                      <Setter Property="Foreground" Value="White"/>
                                      <Setter Property="Background" Value="Transparent"/>
                                      <Setter Property="Padding" Value="0"/>
                                      <Setter Property="Template">
                                          <Setter.Value>
                                              <ControlTemplate TargetType="Button">
                                                  <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                  </Border>
                                              </ControlTemplate>
                                          </Setter.Value>
                                      </Setter>
                                      <Style.Triggers>
                                          <DataTrigger Binding="{Binding ActiveCategory}" Value="game">
                                              <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="Black"/>
                                            <Setter Property="Padding" Value="8,2"/>
                                          </DataTrigger>
                                      </Style.Triggers>
                                  </Style>
                              </Button.Style>
                          </Button>
                      </StackPanel>

                      <!-- 按钮容器，靠右对齐，并设置统一的图标大小和间距 -->
                    <StackPanel  Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">

                        <!-- 1. 设置按钮 -->
                        <Button Command="{Binding OpenConfigCmd}" Background="Transparent" BorderThickness="0" ToolTip="设置" Margin="0,5,5,0" Height="37">
                            <Image Source="/Resource/cog-fill-w.png" Width="30" Height="25" />
                        </Button>

                        <!-- 2. 账户下拉选单 -->
                        <Menu Background="Transparent" >
                            <MenuItem Padding="8" ToolTip="账户" Height="45" RenderTransformOrigin="0.517,0.112">
                                <MenuItem.Header>
                                    <Image Source="/Resource/user-group-w.png" Width="40" Height="28"  />
                                </MenuItem.Header>

                                <!-- 下拉菜单项 -->
                                <MenuItem Header="个人资料" Command="{Binding}"/>
                                <MenuItem Header="修改密码" Command="{Binding}"/>
                                <Separator />
                                <MenuItem Header="退出登录" Command="{Binding}"/>
                            </MenuItem>
                        </Menu>
                    </StackPanel>
                </Grid>
            </Border>


            <!-- 筛选区域 -->
            <Border Grid.Row="1" Margin="20"  BorderBrush="#f1b054"  BorderThickness="1"  CornerRadius="10"  Background="Transparent">

                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <!-- 搜索栏 -->
                        <RowDefinition Height="Auto"/>
                        <!-- 标签筛选 -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 1. 搜索栏 -->
                    <TextBox Grid.Row="0" Height="35" Margin="0,0,0,15" Background="#333333" Foreground="White" BorderBrush="#555555" 
                             BorderThickness="1" Padding="10,0" VerticalContentAlignment="Center" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="#f1b054"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <!-- 这里的 Border 负责显示圆角和背景色 -->
                                <Border x:Name="border"  CornerRadius="8" Background="#333333" BorderBrush="#555555" BorderThickness="1" 
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer x:Name="PART_ContentHost"  Focusable="false"  HorizontalScrollBarVisibility="Hidden"  VerticalScrollBarVisibility="Hidden"/>
                                </Border>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="true">
                                        <Setter Property="BorderBrush" TargetName="border" Value="#f1b054"/>
                                    </Trigger>
                                    <Trigger Property="IsFocused" Value="true">
                                        <Setter Property="BorderBrush" TargetName="border" Value="#f1b054"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>

                    <!-- 2. 标签筛选区 -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Tags}" Margin="10,5,10,5">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}"
                    Command="{Binding DataContext.ToggleTagCmd, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding Name}"
                    Margin="0,0,8,8" Padding="12,4" FontSize="13"
                    Cursor="Hand" BorderThickness="0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#333333"/>
                                            <Setter Property="Foreground" Value="#AAAAAA"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <!-- 核心：重写控件模板，使用 Border 实现圆角 -->
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="border" 
                                            Background="{TemplateBinding Background}" 
                                            CornerRadius="5" 
                                            Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <!-- 选中状态：白底黑字 -->
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="Foreground" Value="Black"/>
                                                </DataTrigger>
                                                <!-- 可选：增加鼠标悬停时的透明度变化，提升交互体验 -->
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Opacity" Value="0.8"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </Grid>
            </Border>

            <!-- 电影海报展示区 (Grid.Row=2) -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="10,0">
                <ItemsControl ItemsSource="{Binding CurrentPageMovies}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="180" Height="280" Margin="8" Background="#2A2A28"
                                    CornerRadius="8" ClipToBounds="True"
                                    MouseLeftButtonDown="MovieCard_Click"
                                      MouseRightButtonDown="MovieCard_RightClick">
                                <StackPanel>
                                    <!-- 海报图片（PosterPath 非空时显示） -->
                                    <Image Source="{Binding PosterPath}"
                                           Width="180" Height="240" Stretch="UniformToFill"
                                           HorizontalAlignment="Center">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PosterPath}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>

                                    <!-- 海报占位（PosterPath 为 null 时显示） -->
                                    <Grid Width="180" Height="240" Background="#3A3A38">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PosterPath}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <TextBlock Text="🎬" FontSize="48" Foreground="#666666"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- 标题 -->
                                    <TextBlock Text="{Binding Title}" Foreground="#E0E0E0" FontSize="13"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="5,8,5,5" TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" MaxWidth="170"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 分页控件区域 -->
            <Border Grid.Row="3" Background="#f1b054" CornerRadius="10,10,0,0" Padding="15,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                    <!-- 首页按钮 -->
                    <Button Content="⏮" Command="{Binding FirstPageCmd}"
                            Width="32" Height="32" Margin="2,0" FontSize="14"
                            Background="Black" Foreground="White" BorderThickness="0" Cursor="Hand"
                            ToolTip="第一页"/>
                    <!-- 上一页按钮 -->
                    <Button Content="◀" Command="{Binding PrevPageCmd}"
                            Width="32" Height="32" Margin="2,0" FontSize="12"
                            Background="Black" Foreground="White" BorderThickness="0" Cursor="Hand"
                            ToolTip="上一页 (←)"/>

                    <!-- 页码小方块（当前页±3） -->
                    <ItemsControl ItemsSource="{Binding PageNumbers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="32" Height="32" Margin="4,0">
                                    <Button Content="{Binding}" Visibility="{Binding Converter={StaticResource NullToVisibilityConverter}}"
                                            Command="{Binding DataContext.GoToPageCmd, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" FontSize="14" Cursor="Hand" BorderThickness="0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Black"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource PageMatchConverter}">
                                                                <Binding/>
                                                                <Binding RelativeSource="{RelativeSource AncestorType=Window}"
                                                                         Path="DataContext.CurrentPage"/>
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="Foreground" Value="Black"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 下一页按钮 -->
                    <Button Content="▶" Command="{Binding NextPageCmd}"
                            Width="32" Height="32" Margin="2,0" FontSize="12"
                            Background="Black" Foreground="White" BorderThickness="0" Cursor="Hand"
                            ToolTip="下一页 (→)"/>
                    <!-- 末页按钮 -->
                    <Button Content="⏭" Command="{Binding LastPageCmd}"
                            Width="32" Height="32" Margin="2,0" FontSize="14"
                            Background="Black" Foreground="White" BorderThickness="0" Cursor="Hand"
                            ToolTip="最后一页"/>

                    <!-- 跳转输入框（跟在方块后面） -->
                    <TextBlock Text="跳转" Foreground="Black" VerticalAlignment="Center" Margin="20,0,5,0" FontSize="14"/>
                    <TextBox Text="{Binding JumpPageText, UpdateSourceTrigger=PropertyChanged}"
                             Width="50" Height="32" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                             FontSize="14" Background="Black" Foreground="White" BorderBrush="#555555" BorderThickness="1" Padding="0">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding JumpPageCmd}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <Button Content="随机"
                              Command="{Binding FillRandomCmd}"
                              Width="70" Height="32"
                              FontSize="13" Foreground="White" Background="#333333"
                              BorderBrush="#555555" BorderThickness="1"
                              Margin="10,0,0,0" Cursor="Hand"
                              ToolTip="用随机电影填满当前页">
                    </Button>

                </StackPanel>
            </Border>
        </Grid>


    </Grid>

</Window>
