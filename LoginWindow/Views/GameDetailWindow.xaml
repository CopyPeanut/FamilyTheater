<Window x:Class="LoginWindow.Views.GameDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LoginWindow.Views"
        Title="游戏详情" Background="#1E1E1D"
        Width="1000" Height="760"
        WindowStartupLocation="CenterOwner"
        Style="{DynamicResource WindowBaseStyle}"
        ResizeMode="NoResize">
    <Window.Resources>
        <local:StringToImageConverter x:Key="StringToImage"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="360"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Top">
                <TextBox x:Name="TitleInput" Margin="0,0,0,12"
                         Foreground="#f1b054" FontSize="20" FontWeight="Bold"
                         Background="#333333" BorderBrush="#555555" BorderThickness="1"
                         Padding="8,4" VerticalContentAlignment="Center"
                         KeyDown="TitleInput_KeyDown"
                         LostFocus="TitleInput_LostFocus"/>

                <TextBlock Text="文件夹位置" Foreground="#888888" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="FolderPathText" IsReadOnly="True"
                         Foreground="#CCCCCC" FontSize="13" Background="#2A2A28"
                         BorderBrush="#444444" BorderThickness="1"
                         Padding="8,4" Margin="0,0,0,12"
                         TextWrapping="Wrap" Height="48"
                         VerticalScrollBarVisibility="Auto"
                         IsReadOnlyCaretVisible="True" Cursor="IBeam"/>

                <TextBlock Text="启动项" Foreground="#888888" FontSize="12" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="LaunchPathText" Grid.Column="0" IsReadOnly="True"
                             Foreground="#CCCCCC" FontSize="13" Background="#2A2A28"
                             BorderBrush="#444444" BorderThickness="1"
                             Padding="8,4" TextWrapping="Wrap"
                             IsReadOnlyCaretVisible="True" Cursor="IBeam"/>
                    <Button Grid.Column="1" Content="选择 exe" Click="SelectLaunch_Click"
                            Height="30" Margin="8,0,0,0" Padding="14,0"
                            Background="#f1b054" Foreground="#1E1E1D" FontWeight="Bold"
                            BorderThickness="0" Cursor="Hand" FontSize="13"/>
                </Grid>

                <TextBlock Text="截图目录" Foreground="#888888" FontSize="12" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ScreenshotRootPathText" Grid.Column="0" IsReadOnly="True"
                             Foreground="#CCCCCC" FontSize="13" Background="#2A2A28"
                             BorderBrush="#444444" BorderThickness="1"
                             Padding="8,4" TextWrapping="Wrap"
                             IsReadOnlyCaretVisible="True" Cursor="IBeam"/>
                    <Button Grid.Column="1" Content="选择目录" Click="SelectScreenshotRoot_Click"
                            Height="30" Margin="8,0,0,0" Padding="14,0"
                            Background="#f1b054" Foreground="#1E1E1D" FontWeight="Bold"
                            BorderThickness="0" Cursor="Hand" FontSize="13"/>
                </Grid>

                <TextBlock Text="Tag" Foreground="#888888" FontSize="12" Margin="0,0,0,6"/>
                <ItemsControl x:Name="GameTagsList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}" Click="RemoveTag_Click"
                                    Margin="0,0,8,6" Padding="10,4" FontSize="13"
                                    Cursor="Hand" BorderThickness="0"
                                    Background="#f1b054" Foreground="#1E1E1D"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Border Grid.Column="1" Width="200" Height="280" CornerRadius="8"
                    Background="#2A2A28" ClipToBounds="True" VerticalAlignment="Top">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="选择海报..." Click="SelectPoster_Click"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Image x:Name="PosterImage" Stretch="UniformToFill"/>
                    <TextBlock Text="GAME" FontSize="28" FontWeight="Bold" Foreground="#666666"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               x:Name="PosterPlaceholder"/>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="1" Margin="20,0,20,20" BorderThickness="1"
                CornerRadius="10" Background="#222220">
            <Grid>
                <ScrollViewer x:Name="ScreenshotScrollViewer"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="ScreenshotScrollViewer_PreviewMouseWheel">
                    <ItemsControl x:Name="ScreenshotList" Margin="10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="180" Height="104" Margin="0,0,10,0"
                                        Background="Transparent"
                                        ClipToBounds="True" Cursor="Hand"
                                        MouseLeftButtonDown="Screenshot_Click">
                                    <Image Source="{Binding Converter={StaticResource StringToImage}}"
                                           Stretch="UniformToFill"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="NoScreenshotsText" Text="未关联截图目录或目录内没有图片"
                           Foreground="#777777" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="20,0,20,20" BorderBrush="#f1b054" BorderThickness="1"
                CornerRadius="10" Background="Transparent">
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewTagInput" Grid.Column="0" Height="32"
                             Background="#333333" Foreground="White" BorderBrush="#555555"
                             BorderThickness="1" Padding="8,0" VerticalContentAlignment="Center"
                             FontSize="13" KeyDown="NewTagInput_KeyDown"/>
                    <Button Grid.Column="1" Content="添加" Click="AddNewTag_Click"
                            Height="32" Margin="8,0,0,0" Padding="16,0"
                            Background="#f1b054" Foreground="#1E1E1D" FontWeight="Bold"
                            BorderThickness="0" Cursor="Hand" FontSize="13"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="AllTagsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}" Click="ToggleTag_Click"
                                        Margin="0,0,8,6" Padding="12,4" FontSize="13"
                                        Cursor="Hand" BorderThickness="0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#333333"/>
                                            <Setter Property="Foreground" Value="#AAAAAA"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="Foreground" Value="Black"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
